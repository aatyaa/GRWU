{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [
    "dist",
    "node_modules",
    "pipeline",
    "playwright-report",
    "test-results",
    "private/paper",
    "public/ringdown-assets",
    "public/pyodide",
    ".cache"
  ],
  "compilerOptions": {
    "paths": {
      "~/*": ["./src/*"],
      "@track/*": ["./private/track/*"]
    },
    "types": ["node"]
  }
}
