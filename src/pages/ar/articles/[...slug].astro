---
/**
 * Arabic article pages (ADR 0012, Phase 3+).
 * This route is empty until Arabic articles (index.ar.mdx) are written.
 * When articlesAr has entries, getStaticPaths returns their slugs here.
 */
import { render, getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { withBase } from '~/lib/url';
import { localePath } from '~/lib/i18n';

export async function getStaticPaths() {
  const articles = await getCollection('articlesAr', (a) => a.data.translationStatus !== 'draft');
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const { title, summary, translationStatus } = article.data;
---

<BaseLayout
  title={title}
  description={summary}
  lang="ar"
  canonicalPath={`articles/${article.id}/`}
  noindex={translationStatus === 'review'}
>
  <article class="article-ar">
    <header>
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
      <p class="en-link">
        <a href={withBase(localePath('en', `articles/${article.id}/`))}>Read in English</a>
      </p>
    </header>
    <div class="body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .article-ar {
    max-width: calc(var(--measure) + 2 * var(--gutter));
    margin-inline: auto;
    padding: clamp(2rem, 6vh, 4rem) var(--gutter) var(--space-16);
  }

  .summary {
    font-size: 1.1rem;
    color: var(--ink-soft);
  }

  .en-link {
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .body {
    margin-top: var(--space-8);
  }
</style>
