---
import 'katex/dist/katex.min.css';
import BaseLayout from '~/layouts/BaseLayout.astro';
import BinaryHero, { type Segment } from '~/components/hero/BinaryHero.astro';
import HowToDemo from '~/components/figures/HowToDemo.svelte';
import Thumb from '~/components/site/Thumb.astro';
import { tex } from '~/components/math/tex';
import { getArticles, getRingdownArticles } from '~/lib/content';
import { sealedArticles, sealedMode } from '~/lib/ringdown';
import { foundations, tracks } from '~/lib/tracks';
import { withBase } from '~/lib/url';

type Kind = 'squares' | 'chirp' | 'ringdown' | 'spectrum' | 'map' | 'bell';

interface Card {
  id: string;
  title: string;
  question: string;
  summary: string;
  thumb: Kind;
  /** Set when the article is published; otherwise the card says it is coming. */
  href?: string;
  minutes?: number;
  /** The part of the GW250114 signal the article explains (the hero's map). */
  part: { id: string; name: string; from: number; to: number; at: number };
}

const articles = await getArticles();
const published = new Map(articles.map((a) => [a.id, a]));
const parts = {
  noise: { id: 'noise', name: 'The noise', from: -0.264, to: -0.16, at: -0.26 },
  inspiral: { id: 'inspiral', name: 'The inspiral', from: -0.16, to: -0.006, at: -0.12 },
  merger: { id: 'merger', name: 'The merger', from: -0.006, to: 0.006, at: -0.004 },
  ringdown: { id: 'ringdown', name: 'The ringdown', from: 0.006, to: 0.059, at: 0.008 },
};

const planned: Omit<Card, 'href' | 'minutes'>[] = [
  {
    id: 'the-shape-of-error',
    title: 'The Shape of Error',
    question: 'How do you find what you cannot see?',
    summary: 'Why every measurement misses, and how least squares finds the truth anyway.',
    thumb: 'squares',
    part: parts.noise,
  },
  {
    id: 'hidden-in-the-noise',
    title: 'Hidden in the Noise',
    question: 'How do you find a signal buried in noise?',
    summary: 'Whitening and the matched filter: how a chirp is pulled out of the detector data.',
    thumb: 'chirp',
    part: parts.inspiral,
  },
  {
    id: 'what-the-wrong-model-knows',
    title: 'What the Wrong Model Knows',
    question: 'What does a fit that looks right hide?',
    summary: 'An incomplete template does not fail. It moves the error into the answer.',
    thumb: 'ringdown',
    part: parts.ringdown,
  },
  {
    id: 'from-strain-to-source',
    title: 'From Strain to Source',
    question: 'How does a wiggle become two black holes?',
    summary: 'The whole route, from a detector shaking to a measurement you can defend.',
    thumb: 'spectrum',
    part: parts.merger,
  },
];

const cards: Card[] = planned.map((card) => {
  const article = published.get(card.id);
  return article
    ? {
        ...card,
        title: article.data.title,
        question: article.data.headline ?? card.question,
        href: withBase(`articles/${article.id}/`),
        minutes: article.data.minutes,
      }
    : card;
});

// The hero's map follows the signal in time, not the order of the cards.
const order = ['noise', 'inspiral', 'merger', 'ringdown'];
const segments: Segment[] = [...cards]
  .sort((a, b) => order.indexOf(a.part.id) - order.indexOf(b.part.id))
  .map((card) => ({
    id: card.part.id,
    part: card.part.name,
    title: card.title,
    href: card.href ?? `#${card.id}`,
    from: card.part.from,
    to: card.part.to,
    at: card.part.at,
  }));

const first = cards.find((card) => card.href);

// Published articles beyond the four on the signal map.
const moreThumbs: Record<string, Kind> = {
  'almost-none-of-it': 'map',
  'laplace-closes-the-circle': 'bell',
};
const more = articles.filter((a) => !planned.some((p) => p.id === a.id));

// The ringdown track (ADR 0007): only its public teaser, the chapter titles and questions
// that /ringdown/ already shows. The chapters themselves stay sealed.
const trackSource = sealedMode ? [] : await getRingdownArticles();
const track = (
  trackSource.length ? trackSource.map(({ id, data }) => ({ slug: id, ...data })) : sealedArticles()
).filter((a) => a.status !== 'draft');

// Every track on the site (ADR 0009): the foundations series, the flagship tracks, the open ones.
const codeTrack = tracks.find((t) => t.id === 'code');
const openTracks = tracks.filter((t) => t.kind === 'open');

// The ring behind the panel: a damped tone and its envelope, drawn once at build time.
const RW = 640;
const RH = 120;
const ringPoints = Array.from({ length: 321 }, (_, i) => {
  const u = i / 320;
  const y = Math.exp(-3.2 * u) * Math.cos(2 * Math.PI * 9 * u);
  return [u * RW, RH / 2 - y * (RH / 2 - 6)] as const;
});
const ringPath = ringPoints
  .map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)},${y.toFixed(1)}`)
  .join('');
const envelope = (sign: 1 | -1) =>
  Array.from({ length: 81 }, (_, i) => {
    const u = i / 80;
    const y = RH / 2 - sign * Math.exp(-3.2 * u) * (RH / 2 - 6);
    return `${i ? 'L' : 'M'}${(u * RW).toFixed(1)},${y.toFixed(1)}`;
  }).join('');
---

<BaseLayout>
  <BinaryHero segments={segments}>
    <p class="hero__kicker">Gravitational-wave data analysis, explained visually</p>
    <h1>How do we know this was two black holes?</h1>
    <p class="hero__text">
      On 14 January 2025 the LIGO detectors recorded GW250114, the clearest signal yet of two black
      holes merging. The scene behind this text is driven by that recording. These interactive
      articles teach how such signals are found in the noise, measured and checked, with the real
      data.
    </p>
    <div class="hero__actions">
      {first && (
        <a class="hero__cta" href={first.href}>
          Start with {first.title} →
        </a>
      )}
      <a class="hero__more" href="#articles">
        All articles
      </a>
      <a class="hero__more" href="#start">
        New? Start here
      </a>
      {track.length > 0 && (
        <a class="hero__more" href="#ringdown-track">
          The ringdown track
        </a>
      )}
    </div>
  </BinaryHero>

  <section class="container section" id="articles" aria-labelledby="articles-title">
    <header class="section__head">
      <h2 id="articles-title">Articles</h2>
      <p>Each article takes one part of the signal and one idea, and lets you work it out.</p>
    </header>
    <ul class="cards">
      {cards.map((card) => (
        <li class:list={['card', 'thumb-host', { upcoming: !card.href }]} id={card.id}>
          {card.href ? (
            <a href={card.href}>
              <div class="card__image">
                <Thumb kind={card.thumb} />
              </div>
              <div class="card__body">
                <p class="card__part">{card.part.name}</p>
                <h3>{card.title}</h3>
                <p class="card__question">{card.question}</p>
                <p class="card__summary">{card.summary}</p>
                <p class="card__meta">
                  {card.minutes && <span>{card.minutes} min read</span>}
                  <span class="card__cta">Read →</span>
                </p>
              </div>
            </a>
          ) : (
            <div>
              <div class="card__image">
                <Thumb kind={card.thumb} />
              </div>
              <div class="card__body">
                <p class="card__part">{card.part.name}</p>
                <h3>{card.title}</h3>
                <p class="card__question">{card.question}</p>
                <p class="card__summary">{card.summary}</p>
                <p class="card__meta">
                  <span class="card__soon">Coming soon</span>
                </p>
              </div>
            </div>
          )}
        </li>
      ))}
    </ul>
  </section>

  <section class="container section" id="start" aria-labelledby="start-title">
    <div class="start">
      <header class="start__head">
        <h2 id="start-title">New to this? Start here</h2>
        <p>
          Five articles for a first-year student. Each joins a piece of physics, statistics and
          signal analysis, so that the research tracks below make sense.
        </p>
        <a class="start__cta" href={withBase('start/')}>
          Start the foundations →
        </a>
      </header>
      <ol class="start__list">
        {foundations.map((a, i) => (
          <li>
            <span class="start__n" aria-hidden="true">
              {i + 1}
            </span>
            <span>
              <span class="start__title">{a.title}</span>
              <span class="start__q">{a.question}</span>
            </span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {track.length > 0 && (
    <section class="container section" id="ringdown-track" aria-labelledby="track-title">
      <div class="track">
        <svg
          class="track__ring"
          viewBox={`0 0 ${RW} ${RH}`}
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <path class="track__env" d={envelope(1)} />
          <path class="track__env" d={envelope(-1)} />
          <path class="track__wave" d={ringPath} />
        </svg>
        <div class="track__intro">
          <p class="track__label">A research track in {track.length} chapters</p>
          <h2 id="track-title">Heavier Than Its Parents</h2>
          <p class="track__lede">
            Fit a single tone to the ringdown of GW250114 and the black hole it describes weighs
            more than the two that made it. This track takes apart, chapter by chapter, the paper
            that explains why, with its own figures drawn from its own data.
          </p>
          <p class="track__byline">
            By Attia A. Gadallah, from an unpublished paper. Open by request.
          </p>
          <div class="track__actions">
            <a class="track__cta" href={withBase('ringdown/#request')}>
              Request access →
            </a>
            <a class="track__code" href={withBase('ringdown/')}>
              I have a code
            </a>
          </div>
          {codeTrack && (
            <div class="track__next">
              <p class="track__next-label">
                {codeTrack.status === 'live' ? 'Also in this track' : 'Coming next, same access'}
              </p>
              <p class="track__next-title">{codeTrack.title}</p>
              <p class="track__next-text">{codeTrack.summary}</p>
            </div>
          )}
        </div>
        <ol class="track__chapters">
          {track.map((a, i) => (
            <li>
              <a href={withBase(`ringdown/${a.slug}/`)}>
                <span class="track__n" aria-hidden="true">
                  {i + 1}
                </span>
                <span class="track__text">
                  <span class="track__title">{a.title}</span>
                  {a.headline && <span class="track__q">{a.headline}</span>}
                </span>
                <svg class="track__lock" viewBox="0 0 16 16" aria-hidden="true">
                  <rect x="3" y="7" width="10" height="7" rx="1.5" />
                  <path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" />
                </svg>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <section class="container section" id="open-tracks" aria-labelledby="open-title">
    <header class="section__head">
      <h2 id="open-title">Open tracks</h2>
      <p>
        Short tracks built on open-source work that deserves its own path, redrawn in this site's
        style and credited to the people who made it. Open to everyone.
      </p>
    </header>
    <ul class="cards open">
      {openTracks.map((t) => (
        <li class="card open__card" id={`track-${t.id}`}>
          <div>
            <div class="card__body">
              <h3>{t.path ? <a href={withBase(t.path)}>{t.title}</a> : t.title}</h3>
              <p class="card__question">{t.question}</p>
              <p class="card__summary">{t.summary}</p>
              {t.credits?.map((c) => (
                <p class="open__credit">
                  Built on <a href={c.url}>{c.project}</a> by {c.authors} ({c.license})
                </p>
              ))}
              <p class="card__meta">
                <span class="card__soon">{t.status === 'live' ? 'Open' : 'Coming soon'}</span>
              </p>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </section>

  {more.length > 0 && (
    <section class="container section" aria-labelledby="more-title">
      <header class="section__head">
        <h2 id="more-title">More articles</h2>
        <p>Beyond the signal: the rest of the material, and what the work is made of.</p>
      </header>
      <ul class="cards">
        {more.map((article) => (
          <li class="card thumb-host" id={article.id}>
            <a href={withBase(`articles/${article.id}/`)}>
              <div class="card__image">
                <Thumb kind={moreThumbs[article.id] ?? 'spectrum'} />
              </div>
              <div class="card__body">
                <h3>{article.data.title}</h3>
                <p class="card__question">{article.data.headline ?? article.data.summary}</p>
                <p class="card__summary">{article.data.summary}</p>
                <p class="card__meta">
                  {article.data.minutes && <span>{article.data.minutes} min read</span>}
                  <span class="card__cta">Read →</span>
                </p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="container section" aria-labelledby="how-title">
    <header class="section__head">
      <h2 id="how-title">How to read them</h2>
      <p>Every article is built from three moves. Try them here.</p>
    </header>
    <div class="how">
      <div class="how__item">
        <h3>Scroll</h3>
        <p>The text drives the figure beside it.</p>
        <HowToDemo client:visible kind="scroll" />
      </div>
      <div class="how__item">
        <h3>Drag</h3>
        <p>Move the data yourself and watch the answer follow.</p>
        <HowToDemo client:visible kind="drag" />
      </div>
      <div class="how__item">
        <h3>Open the math</h3>
        <p>Under each idea is its derivation, closed until you want it.</p>
        <details class="how__math">
          <summary>The math: the best line</summary>
          <div
            class="how__eq"
            set:html={tex('\\hat\\theta = \\arg\\min_\\theta \\sum_i (y_i - a - b\\,x_i)^2')}
          />
          <p>The best line is the one whose misses have the smallest total of squares.</p>
        </details>
      </div>
    </div>
  </section>

  <section class="container section trust" aria-label="Why you can trust it">
    <div>
      <h3>Real data</h3>
      <p>
        Signals come from the{' '}
        <a href="https://gwosc.org/">Gravitational Wave Open Science Center</a>: LIGO, Virgo and
        KAGRA recordings, analysed in your browser.
      </p>
    </div>
    <div>
      <h3>Checked computations</h3>
      <p>
        Every signal-processing function is tested against scipy and gwpy before an article uses it.
      </p>
    </div>
    <div>
      <h3>Sources you can follow</h3>
      <p>Written by Attia A. Gadallah. Every article ends with the papers and books it rests on.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero__kicker {
    margin: 0 0 0.9rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: #e5a343;
  }

  h1 {
    margin: 0 0 1rem;
    font-size: clamp(2.3rem, 4.6vw, 3.9rem);
    color: #e7edf5;
  }

  .hero__text {
    max-width: 34rem;
    margin: 0 0 1.5rem;
    font-size: 1.05rem;
    line-height: 1.6;
    color: #b4c0d0;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    align-items: center;
  }

  .hero__cta {
    display: inline-block;
    padding: 0.7rem 1.2rem;
    border: 1px solid #e5a343;
    border-radius: 999px;
    background: rgb(229 163 67 / 0.14);
    font-weight: 600;
    color: #f2be6a;
  }

  .hero__cta:hover {
    background: rgb(229 163 67 / 0.26);
    color: #fff;
  }

  .hero__more {
    border-bottom: 1px solid rgb(231 237 245 / 0.4);
    font-weight: 500;
    color: #e7edf5;
  }

  .section {
    margin-top: var(--space-16);
  }

  .section__head {
    margin-bottom: var(--space-8);
  }

  .section__head h2 {
    margin: 0 0 0.4rem;
    font-size: clamp(2rem, 4vw, 2.7rem);
  }

  .section__head p {
    margin: 0;
    font-size: 1.05rem;
    color: var(--ink-soft);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    overflow: hidden;
    border: 1px solid var(--rule-soft);
    border-radius: 12px;
    background: var(--surface);
    box-shadow: var(--shadow);
    scroll-margin-top: 5rem;
    transition:
      transform var(--dur-fast) var(--ease),
      box-shadow var(--dur-fast) var(--ease);
  }

  .card:not(.upcoming):hover {
    transform: translateY(-3px);
  }

  .card > a,
  .card > div {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 0;
    padding: 0;
    color: inherit;
  }

  .card__image {
    padding: 1.1rem 1.1rem 0.4rem;
    border-bottom: 1px solid var(--rule-soft);
    background: var(--surface-2);
  }

  .card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.1rem 1.2rem 1.2rem;
  }

  .card__part {
    margin: 0 0 0.35rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--signal);
  }

  .card h3 {
    margin: 0 0 0.45rem;
    font-size: 1.6rem;
    line-height: 1.1;
    color: var(--ink);
  }

  .card__question {
    margin: 0 0 0.6rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--ink);
  }

  .card__summary {
    margin: 0 0 1rem;
    font-size: 0.93rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .card__meta {
    display: flex;
    justify-content: space-between;
    margin: auto 0 0;
    font-size: 0.88rem;
    color: var(--ink-soft);
  }

  .card__cta {
    font-weight: 600;
    color: var(--signal);
  }

  .card__soon {
    color: var(--ink-faint);
  }

  .upcoming .card__image {
    opacity: 0.8;
  }

  .track {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--space-8) var(--space-12);
    overflow: hidden;
    padding: clamp(1.5rem, 4vw, 3rem);
    border-radius: 16px;
    background:
      radial-gradient(ellipse at 15% 0%, rgb(229 163 67 / 0.12), transparent 55%), var(--space);
    color: var(--space-ink);
    scroll-margin-top: 5rem;
  }

  .track__ring {
    grid-column: 1 / -1;
    width: 100%;
    height: clamp(4rem, 9vw, 7rem);
    margin-bottom: calc(-1 * var(--space-4));
    opacity: 0.7;
  }

  .track__wave {
    fill: none;
    stroke: var(--space-signal);
    stroke-width: 1.6;
    vector-effect: non-scaling-stroke;
  }

  .track__env {
    fill: none;
    stroke: var(--space-cool);
    stroke-width: 1;
    stroke-dasharray: 4 4;
    vector-effect: non-scaling-stroke;
  }

  .track__label {
    margin: 0 0 0.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--space-signal);
  }

  .track h2 {
    margin: 0 0 1rem;
    font-size: clamp(2rem, 4vw, 2.9rem);
    line-height: 1.05;
    color: var(--space-ink);
  }

  .track__lede {
    margin: 0 0 1rem;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--space-ink);
  }

  .track__byline {
    margin: 0 0 1.5rem;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--space-soft);
  }

  .track__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    align-items: center;
  }

  .track__cta {
    display: inline-block;
    padding: 0.7rem 1.2rem;
    border: 1px solid var(--space-signal);
    border-radius: 999px;
    background: rgb(229 163 67 / 0.14);
    font-weight: 600;
    color: #f2be6a;
  }

  .track__cta:hover {
    background: rgb(229 163 67 / 0.26);
    color: #fff;
  }

  .track__code {
    border-bottom: 1px solid rgb(231 237 245 / 0.4);
    font-weight: 500;
    color: var(--space-ink);
  }

  .track__chapters {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .track__chapters li + li {
    border-top: 1px solid var(--space-line);
  }

  .track__chapters a {
    display: grid;
    grid-template-columns: 2rem 1fr auto;
    gap: 0.9rem;
    align-items: start;
    padding: 0.8rem 0.4rem;
    border: 0;
    border-radius: 8px;
    color: var(--space-ink);
    transition: background var(--dur-fast) var(--ease);
  }

  .track__chapters a:hover,
  .track__chapters a:focus-visible {
    background: rgb(231 237 245 / 0.06);
  }

  .track__n {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border: 1px solid rgb(229 163 67 / 0.6);
    border-radius: 50%;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--space-signal);
  }

  .track__text {
    display: grid;
    gap: 0.15rem;
  }

  .track__title {
    font-family: var(--f-display);
    font-size: 1.2rem;
    line-height: 1.2;
  }

  .track__q {
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--space-soft);
  }

  .track__lock {
    width: 1rem;
    height: 1rem;
    margin-top: 0.35rem;
    fill: none;
    stroke: var(--space-faint);
    stroke-width: 1.4;
  }

  @media (max-width: 860px) {
    .track {
      grid-template-columns: 1fr;
    }
  }

  .start {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: var(--space-8) var(--space-12);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid var(--rule-soft);
    border-radius: 16px;
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .start__head h2 {
    margin: 0 0 0.6rem;
    font-size: clamp(1.9rem, 3.6vw, 2.5rem);
    line-height: 1.05;
  }

  .start__head p {
    margin: 0 0 1.3rem;
