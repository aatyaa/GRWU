---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getArticles } from '~/lib/content';
import { withBase } from '~/lib/url';

const articles = await getArticles();
---

<BaseLayout>
  <section class="hero container">
    <h1>Gravitational-wave data analysis, explained visually</h1>
    <p class="lede">
      Interactive articles that take you from raw detector data to a detection and a measured
      merger. Every step runs on real LIGO and Virgo data in your browser, so you can hear it, move
      it and see why it works.
    </p>
  </section>

  <section class="container" aria-labelledby="articles-heading">
    <h2 id="articles-heading">Articles</h2>
    {articles.length === 0 ? (
      <p class="empty">The first article is being written.</p>
    ) : (
      <ol class="article-list">
        {articles.map((article) => (
          <li>
            <a href={withBase(`articles/${article.id}/`)}>
              <span class="article-list__title">{article.data.title}</span>
              <span class="article-list__summary">{article.data.summary}</span>
            </a>
            {article.data.status !== 'published' && (
              <span class="article-list__status">{article.data.status}</span>
            )}
          </li>
        ))}
      </ol>
    )}
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-16) var(--space-12);
  }

  .hero h1 {
    max-width: 20ch;
    margin: 0 0 var(--space-6);
    font-size: var(--text-3xl);
  }

  .lede {
    max-width: var(--measure);
    margin: 0;
    font-size: var(--text-lg);
    color: var(--ink-2);
  }

  .empty {
    color: var(--ink-2);
  }

  .article-list {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .article-list li {
    position: relative;
    padding: var(--space-4) var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-2);
    background: var(--surface-1);
  }

  .article-list a {
    display: grid;
    gap: var(--space-1);
    color: inherit;
    text-decoration: none;
  }

  .article-list__title {
    font-size: var(--text-lg);
    font-weight: 650;
  }

  .article-list a:hover .article-list__title {
    text-decoration: underline;
  }

  .article-list__summary {
    color: var(--ink-2);
  }

  .article-list__status {
    position: absolute;
    top: var(--space-4);
    inset-inline-end: var(--space-4);
    padding: 0 var(--space-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-1);
    font-size: var(--text-sm);
    color: var(--ink-2);
  }
</style>
