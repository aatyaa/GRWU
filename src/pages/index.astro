---
import BaseLayout from '~/layouts/BaseLayout.astro';
import BinaryHero from '~/components/hero/BinaryHero.astro';
import Thumb from '~/components/site/Thumb.astro';
import { getArticles } from '~/lib/content';
import { withBase } from '~/lib/url';

const articles = await getArticles();

const thumbs: Record<string, 'squares' | 'chirp' | 'ringdown' | 'spectrum'> = {
  'the-shape-of-error': 'squares',
};

const upcoming = [
  {
    title: 'Hidden in the Noise',
    summary:
      'Why the first gravitational wave was invisible in the raw data, and how whitening and a matched filter found it.',
    thumb: 'chirp' as const,
  },
  {
    title: 'What the Wrong Model Knows',
    summary:
      'An incomplete template does not fail. It quietly moves the error into the answer. How to catch it.',
    thumb: 'ringdown' as const,
  },
  {
    title: 'From Strain to Source',
    summary:
      'The whole route: from a detector shaking in Louisiana to a measurement you can defend.',
    thumb: 'spectrum' as const,
  },
];
---

<BaseLayout>
  <BinaryHero>
    <p class="hero__kicker">GW250114 · two black holes, 1.3 billion light-years away</p>
    <h1>
      Gravitational-wave data analysis, <em>explained visually</em>
    </h1>
    <p class="hero__text">
      Interactive essays on how the signals of colliding black holes are pulled out of detector
      noise, measured and checked. The scene behind this text is driven by the real recording.
    </p>
    <a class="hero__cta" href={withBase(`articles/${articles[0]?.id ?? ''}/`)}>
      Start with {articles[0]?.data.title ?? 'the first essay'} →
    </a>
  </BinaryHero>

  <section class="container articles-head">
    <h2>Articles</h2>
  </section>

  <section class="container" aria-label="Articles">
    <ul class="cards">
      {articles.map((article) => (
        <li class="card">
          <a href={withBase(`articles/${article.id}/`)}>
            <div class="card__image">
              <Thumb kind={thumbs[article.id] ?? 'squares'} />
            </div>
            <div class="card__body">
              <h2>{article.data.title}</h2>
              <p>{article.data.summary}</p>
              <span class="card__cta">Read the article →</span>
            </div>
          </a>
        </li>
      ))}
      {upcoming.map((essay) => (
        <li class="card upcoming">
          <div class="card__image">
            <Thumb kind={essay.thumb} />
          </div>
          <div class="card__body">
            <h2>{essay.title}</h2>
            <p>{essay.summary}</p>
            <span class="card__cta">Coming soon</span>
          </div>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .hero__kicker {
    margin: 0 0 1rem;
    font-family: var(--f-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: #e5a343;
  }

  h1 {
    margin: 0 0 1.1rem;
    font-size: clamp(2.4rem, 5vw, 4.2rem);
    color: #e7edf5;
  }

  h1 em {
    color: #e5a343;
  }

  .hero__text {
    max-width: 34rem;
    margin: 0 0 1.6rem;
    font-size: 1.1rem;
    line-height: 1.6;
    color: #b4c0d0;
  }

  .hero__cta {
    display: inline-block;
    padding: 0.7rem 1.2rem;
    border: 1px solid #e5a343;
    border-radius: 999px;
    background: rgb(229 163 67 / 0.12);
    font-weight: 600;
    color: #f2be6a;
  }

  .hero__cta:hover {
    background: rgb(229 163 67 / 0.24);
    color: #fff;
  }

  .articles-head h2 {
    margin: var(--space-16) 0 var(--space-6);
    font-size: clamp(2rem, 4vw, 2.8rem);
  }

  @media (max-width: 760px) {
    .hero__text {
      font-size: 1rem;
    }
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    overflow: hidden;
    border: 1px solid var(--rule-soft);
    border-radius: 12px;
    background: var(--surface);
    box-shadow: var(--shadow);
    transition:
      transform var(--dur-fast) var(--ease),
      box-shadow var(--dur-fast) var(--ease);
  }

  .card:not(.upcoming):hover {
    transform: translateY(-3px);
  }

  .card a {
    display: block;
    height: 100%;
    border: 0;
    padding: 0;
    color: inherit;
  }

  .card__image {
    padding: 1.4rem 1.4rem 0.6rem;
    background: var(--surface-2);
    border-bottom: 1px solid var(--rule-soft);
  }

  .card__body {
    padding: 1.2rem 1.4rem 1.4rem;
  }

  .card h2 {
    margin: 0 0 0.5rem;
    font-size: 1.75rem;
    line-height: 1.1;
    color: var(--ink);
  }

  .card p {
    margin: 0 0 1rem;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .card__cta {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--signal);
  }

  .upcoming .card__cta {
    color: var(--ink-faint);
    font-weight: 500;
  }

  .upcoming .card__image {
    opacity: 0.75;
  }
</style>
