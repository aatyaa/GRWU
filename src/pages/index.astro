---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Signature from '~/components/brand/Signature.astro';
import Eyebrow from '~/components/editorial/Eyebrow.astro';
import HeroTrace from '~/components/figures/HeroTrace.astro';
import Title from '~/components/site/Title.astro';
import { getArticles } from '~/lib/content';
import { withBase } from '~/lib/url';

const articles = await getArticles();

// The essays after the first, in reading order. Listed so the path is visible before it exists.
const upcoming = [
  {
    title: 'Hidden in the Noise',
    note: 'The noise spectrum, whitening and the matched filter, on the first detection.',
  },
  {
    title: 'What the Wrong Model Knows',
    note: 'An incomplete template does not fail. It moves the error into the answer.',
  },
  {
    title: 'From Strain to Source',
    note: 'From a mirror shaking in Louisiana to a number you can defend.',
  },
];
---

<BaseLayout>
  <section class="hero container">
    <Eyebrow>Gravitational-wave data analysis, explained</Eyebrow>
    <h1>
      The signal is in there <em>somewhere.</em>
    </h1>
    <p class="lead">
      Interactive essays on how gravitational-wave data is analysed: why errors have a shape, how a
      template pulls a merger out of noise a hundred times louder, and how a confident fit can be
      wrong. The figures move, the data is real, and every claim comes with the test that could have
      broken it.
    </p>
    <HeroTrace />
    <div class="hero__foot">
      <p class="label">What you record = the thing you want + everything else</p>
      <Signature />
    </div>
  </section>

  <section class="container essays" aria-labelledby="essays-heading">
    <Eyebrow>The essays</Eyebrow>
    <h2 id="essays-heading" class="visually-hidden">
      Essays
    </h2>
    {articles.length === 0 ? (
      <p class="empty">The first essay is being written.</p>
    ) : (
      <ol class="essay-list">
        {articles.map((article, i) => (
          <li>
            <a href={withBase(`articles/${article.id}/`)}>
              <span class="essay__index">{String(i + 1).padStart(2, '0')}</span>
              <span class="essay__title">
                <Title text={article.data.title} emphasis={article.data.emphasis} />
              </span>
              <span class="essay__summary">{article.data.headline ?? article.data.summary}</span>
              <span class="essay__meta">
                {article.data.minutes && `${article.data.minutes} min · `}
                {article.data.status === 'published' ? 'read' : article.data.status}
              </span>
            </a>
          </li>
        ))}
      </ol>
    )}

    <div class="upcoming">
      <p class="label">Coming next</p>
      <ol>
        {upcoming.map((essay) => (
          <li>
            <span class="upcoming__title">{essay.title}</span>
            <span class="upcoming__note">{essay.note}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-top: clamp(3rem, 9vh, 6.5rem);
  }

  .hero h1 {
    max-width: 14ch;
  }

  .hero .lead {
    max-width: 56ch;
  }

  .hero__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-6);
    padding-top: 1.2rem;
    border-top: 1px solid var(--rule);
  }

  .hero__foot .label {
    margin: 0;
  }

  .hero__foot :global(.signature) {
    margin-top: 0;
  }

  .essays {
    margin-top: var(--space-24);
  }

  .empty {
    color: var(--ink-soft);
  }

  .essay-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }

  .essay-list a {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto;
    grid-template-areas:
      'index title meta'
      'index summary meta';
    gap: 0.3rem 1.2rem;
    padding: 1.6rem 0;
    border: 0;
    border-bottom: 1px solid var(--rule-soft);
    color: var(--ink);
  }

  .essay__index {
    grid-area: index;
    padding-top: 0.7rem;
    font-family: var(--f-mono);
    font-size: 0.72rem;
    color: var(--signal);
  }

  .essay__title {
    grid-area: title;
    font-family: var(--f-display);
    font-size: clamp(2rem, 4.6vw, 3.4rem);
    line-height: 1.05;
    transition: color var(--dur-fast) var(--ease);
  }

  .essay__title :global(em) {
    font-style: italic;
    color: var(--signal);
  }

  .essay-list a:hover .essay__title {
    color: var(--signal);
  }

  .essay__summary {
    grid-area: summary;
    max-width: 52ch;
    color: var(--ink-soft);
  }

  .essay__meta {
    grid-area: meta;
    align-self: center;
    font-family: var(--f-mono);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .upcoming {
    margin-top: var(--space-12);
  }

  .upcoming ol {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--space-6);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .upcoming li {
    display: grid;
    gap: 0.35rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--rule-soft);
  }

  .upcoming__title {
    font-family: var(--f-display);
    font-size: 1.45rem;
    line-height: 1.15;
    color: var(--ink-soft);
  }

  .upcoming__note {
    font-family: var(--f-mono);
    font-size: 0.72rem;
    line-height: 1.6;
    color: var(--ink-faint);
  }

  @media (max-width: 40rem) {
    .essay-list a {
      grid-template-columns: 2rem minmax(0, 1fr);
      grid-template-areas:
        'index title'
        'index summary'
        'index meta';
    }
  }
</style>
