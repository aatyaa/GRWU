---
import BaseLayout from '~/layouts/BaseLayout.astro';
import IslandCheck from '~/components/lab/IslandCheck.svelte';

const concepts = ['data', 'signal', 'template', 'snr', 'glitch', 'noise'] as const;
---

<BaseLayout title="Lab" description="Component workbench for GRWU." noindex>
  <div class="container lab">
    <h1>Lab</h1>
    <p class="lede">
      A workbench for the building blocks of GRWU articles. Nothing here is published content.
    </p>

    <section aria-labelledby="islands-heading">
      <h2 id="islands-heading">Islands</h2>
      <IslandCheck client:visible />
    </section>

    <section aria-labelledby="colours-heading">
      <h2 id="colours-heading">Concept colours</h2>
      <ul class="swatches">
        {concepts.map((concept) => (
          <li>
            <span class="swatch" style={`--swatch: var(--c-${concept})`} />
            {concept}
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .lab {
    padding-top: var(--space-12);
  }

  .lede {
    max-width: var(--measure);
    color: var(--ink-2);
  }

  section {
    margin-top: var(--space-8);
  }

  .swatches {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .swatches li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .swatch {
    width: 1.5rem;
    height: 0.35rem;
    border-radius: 2px;
    background: var(--swatch);
  }
</style>
