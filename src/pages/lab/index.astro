---
import BaseLayout from '~/layouts/BaseLayout.astro';
import IslandCheck from '~/components/lab/IslandCheck.svelte';
import Eyebrow from '~/components/editorial/Eyebrow.astro';

const colours = [
  { token: 'signal', meaning: 'the signal; anything observed or measured' },
  { token: 'noise', meaning: 'noise; references and schematics' },
  { token: 'model', meaning: 'a model or template (dashed)' },
  { token: 'bias', meaning: 'bias, disagreement, a glitch (always labelled)' },
  { token: 'ok', meaning: 'agreement; a check that passed' },
  { token: 'ink', meaning: 'text and recorded data' },
];
---

<BaseLayout title="Lab" description="Component workbench for GRWU." noindex>
  <div class="container lab">
    <Eyebrow>Workbench · not published</Eyebrow>
    <h1>Lab</h1>
    <p class="lead">The building blocks of GRWU articles, one at a time.</p>

    <section aria-labelledby="islands-heading">
      <h2 id="islands-heading">Islands</h2>
      <IslandCheck client:visible />
    </section>

    <section aria-labelledby="colours-heading">
      <h2 id="colours-heading">Colour carries meaning</h2>
      <ul class="swatches">
        {colours.map((colour) => (
          <li>
            <span class="swatch" style={`--swatch: var(--${colour.token})`} />
            <b>{colour.token}</b>
            <span>{colour.meaning}</span>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .lab {
    padding-top: var(--space-12);
  }

  .swatches {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .swatches li {
    display: grid;
    grid-template-columns: 2rem 5rem 1fr;
    align-items: center;
    gap: 0.8rem;
    font-family: var(--f-mono);
    font-size: 0.8rem;
    color: var(--ink-soft);
  }

  .swatch {
    width: 2rem;
    height: 3px;
    border-radius: 2px;
    background: var(--swatch);
  }

  b {
    font-weight: 500;
    color: var(--ink);
  }
</style>
