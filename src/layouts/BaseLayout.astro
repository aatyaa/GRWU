---
import '~/styles/tokens.css';
import '~/styles/base.css';
import Header from '~/components/site/Header.astro';
import Footer from '~/components/site/Footer.astro';
import { withBase } from '~/lib/url';

interface Props {
  title?: string;
  description?: string;
  /** Keep this page out of search engines (lab pages). */
  noindex?: boolean;
}

const {
  title,
  description = 'Visual, interactive explanations of gravitational-wave data analysis.',
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} · GRWU` : 'GRWU: gravitational-wave data analysis, explained';
// PR previews share the production domain, so they must never be indexed.
const isPreview = import.meta.env.BASE_URL.includes('/pr-preview/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {(noindex || isPreview) && <meta name="robots" content="noindex" />}
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      try {
        const theme = localStorage.getItem('grwu-theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {
        // Storage unavailable: follow the OS setting.
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
