---
import BaseLayout from './BaseLayout.astro';
import type { Article } from '~/lib/content';

interface Props {
  article: Article;
}

const { article } = Astro.props;
const { title, headline, summary, status, minutes, updated, sources } = article.data;

const updatedLabel = updated.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout title={title} description={summary}>
  <article class="article">
    <header class="article__header">
      <h1>{title}</h1>
      {headline && <p class="article__headline">{headline}</p>}
      <p class="article__byline">
        By <strong>Attia A. Gadallah</strong>
        <span aria-hidden="true">·</span>
        <time datetime={updated.toISOString()}>{updatedLabel}</time>
        {minutes && (
          <>
            <span aria-hidden="true">·</span> {minutes} min read
          </>
        )}
        {status !== 'published' && (
          <>
            <span aria-hidden="true">·</span> <em>preview</em>
          </>
        )}
      </p>
    </header>

    <slot name="hero" />

    <div class="article__body">
      <slot />
    </div>

    {sources.length > 0 && (
      <footer class="article__footer">
        <h2>References</h2>
        <ol>
          {sources.map((source) => (
            <li>
              <a href={source.url}>{source.title}</a>
            </li>
          ))}
        </ol>
      </footer>
    )}
  </article>
</BaseLayout>

<style>
  .article__header {
    max-width: 52rem;
    margin: 0 auto;
    padding: clamp(2.5rem, 8vh, 5rem) var(--gutter) 0;
    text-align: center;
  }

  .article__header h1 {
    margin-bottom: 1rem;
    font-size: clamp(3rem, 8vw, 5.5rem);
  }

  .article__headline {
    margin: 0 auto 1.4rem;
    max-width: 34ch;
    font-family: var(--f-display);
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    line-height: 1.2;
    color: var(--ink-soft);
  }

  .article__byline {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.45rem;
    margin: 0;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .article__byline strong {
    font-weight: 600;
  }

  /* The text column; wide figures and scrolly sections break out of it themselves. */
  .article__body,
  .article__footer {
    width: 100%;
    max-width: calc(var(--measure) + 2 * var(--gutter));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .article__body {
    margin-top: var(--space-12);
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--ink);
  }

  .article__body :global(h2) {
    margin-top: var(--space-16);
    font-size: clamp(2rem, 4vw, 2.8rem);
  }

  .article__body :global(ul),
  .article__body :global(ol) {
    padding-inline-start: 1.3rem;
  }

  .article__footer {
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--rule);
  }

  .article__footer h2 {
    margin: 0 0 1rem;
    font-size: 1.6rem;
  }

  .article__footer ol {
    margin: 0;
    padding-inline-start: 1.2rem;
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--ink-soft);
  }
</style>
