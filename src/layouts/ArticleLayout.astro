---
import BaseLayout from './BaseLayout.astro';
import Signature from '~/components/brand/Signature.astro';
import DepthDial from '~/components/depth/DepthDial.astro';
import Eyebrow from '~/components/editorial/Eyebrow.astro';
import Title from '~/components/site/Title.astro';
import type { Article } from '~/lib/content';

interface Props {
  article: Article;
}

const { article } = Astro.props;
const { title, emphasis, headline, eyebrow, byline, summary, status, minutes, updated, sources } =
  article.data;

const updatedLabel = updated.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout title={title} description={summary} running={title}>
  <article class="article">
    <header class="article__header container">
      {status !== 'published' && (
        <p class="status" role="note">
          {status === 'draft' ? 'Draft' : 'In review'} · not published yet
        </p>
      )}
      {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
      <h1>{headline ?? <Title text={title} emphasis={emphasis} />}</h1>
      <p class="lead">{summary}</p>
      <slot name="hero" />
      <div class="article__byline">
        {byline && <p class="label">{byline}</p>}
        <Signature />
        <div class="article__meta">
          <p class="label">
            {minutes && <span>{minutes} min read · </span>}
            Updated <time datetime={updated.toISOString()}>{updatedLabel}</time>
          </p>
          <DepthDial />
        </div>
      </div>
    </header>

    <div class="article__body">
      <slot />
    </div>

    {sources.length > 0 && (
      <footer class="article__footer">
        <Eyebrow tone="faint">Sources</Eyebrow>
        <ol>
          {sources.map((source) => (
            <li>
              <a href={source.url}>{source.title}</a>
            </li>
          ))}
        </ol>
      </footer>
    )}
  </article>
</BaseLayout>

<style>
  .article__header {
    padding-top: clamp(2.5rem, 7vh, 5rem);
  }

  .article__header h1 {
    max-width: 16ch;
  }

  .article__header .lead {
    max-width: 58ch;
  }

  .status {
    display: inline-block;
    margin: 0 0 var(--space-6);
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--signal);
    border-radius: 3px;
    background: var(--signal-bg);
    font-family: var(--f-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--signal);
  }

  .article__byline {
    margin-top: var(--space-8);
    padding-top: 1.2rem;
    border-top: 1px solid var(--rule);
  }

  .article__byline .label {
    margin: 0;
  }

  .article__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  /* The text column; wide figures and scrolly sections break out of it themselves. */
  .article__body,
  .article__footer {
    width: 100%;
    max-width: calc(var(--measure) + 2 * var(--gutter));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .article__body {
    margin-top: var(--space-16);
    color: var(--ink-soft);
  }

  .article__body :global(h2) {
    color: var(--ink);
  }

  .article__body :global(.eyebrow + h2) {
    margin-top: 0;
  }

  .article__body :global(ul),
  .article__body :global(ol) {
    padding-inline-start: 1.2rem;
  }

  .article__footer {
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--rule);
  }

  .article__footer ol {
    margin: 0;
    padding-inline-start: 1.2rem;
    font-family: var(--f-mono);
    font-size: 0.75rem;
    line-height: 1.7;
    color: var(--ink-faint);
  }
</style>
