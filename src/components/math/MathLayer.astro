---
/**
 * The mathematical layer of an idea: a claim, what may be assumed, a numbered derivation
 * with one hinge step, and what it means. Closed by default; the depth control or a link
 * (#id) opens it. Children: <Claim>, <Given>, <Steps>, <Means>, and any figure.
 */
import 'katex/dist/katex.min.css';

interface Props {
  id: string;
  /** Short index shown in the summary, e.g. "M1". */
  number: string;
  title: string;
}

const { id, number, title } = Astro.props;
---

<grwu-unfold class="math-layer">
  <details id={id} data-layer="math" style={`view-transition-name: unfold-${id}`}>
    <summary>
      <span class="math-layer__index">Mathematical layer · {number}</span>
      <span class="math-layer__title">{title}</span>
    </summary>
    <div class="math-layer__body">
      <slot />
    </div>
  </details>
</grwu-unfold>

<script>
  import '~/elements/unfold';
</script>

<style>
  .math-layer {
    display: block;
    margin: var(--space-8) 0;
  }

  details {
    border: 1px solid var(--rule-soft);
    border-left: 2px solid var(--line-faint);
    border-radius: var(--radius-2);
    background: var(--surface-2);
  }

  details[open] {
    border-left-color: var(--signal);
  }

  summary {
    display: grid;
    gap: 2px;
    padding: 0.9rem 1.2rem;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .math-layer__index {
    font-family: var(--f-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .math-layer__index::after {
    content: ' · open';
    color: var(--signal);
  }

  details[open] .math-layer__index::after {
    content: ' · close';
  }

  .math-layer__title {
    font-family: var(--f-display);
    font-size: 1.45rem;
    line-height: 1.2;
    color: var(--ink);
  }

  summary:hover .math-layer__title {
    color: var(--signal);
  }

  .math-layer__body {
    padding: 0.2rem 1.2rem 1.3rem;
  }
</style>

<style is:global>
  ::view-transition-group(*) {
    animation-duration: var(--dur);
    animation-timing-function: var(--ease);
  }
</style>
