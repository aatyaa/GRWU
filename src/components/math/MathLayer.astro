---
/**
 * The mathematical layer of an idea: a claim, what may be assumed, a numbered derivation
 * with one hinge step, and what it means. Closed by default; the reader or a link
 * (#id) opens it. Children: <Claim>, <Given>, <Steps>, <Means>, and any figure.
 */
import 'katex/dist/katex.min.css';

interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<grwu-unfold class="math-layer">
  <details id={id} data-layer="math" style={`view-transition-name: unfold-${id}`}>
    <summary>
      <span class="math-layer__icon" aria-hidden="true"></span>
      <span class="math-layer__title">
        <span class="math-layer__lead">The math:</span> {title}
      </span>
    </summary>
    <div class="math-layer__body">
      <slot />
    </div>
  </details>
</grwu-unfold>

<script>
  import '~/elements/unfold';
</script>

<style>
  .math-layer {
    display: block;
    margin: var(--space-8) 0;
  }

  details {
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }

  summary {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.9rem 0;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .math-layer__icon::before {
    content: '+';
    display: inline-grid;
    place-items: center;
    width: 1.4rem;
    height: 1.4rem;
    border: 1px solid var(--signal);
    border-radius: 50%;
    font-size: 1rem;
    line-height: 1;
    color: var(--signal);
  }

  details[open] .math-layer__icon::before {
    content: '−';
  }

  .math-layer__title {
    font-size: 1.05rem;
    color: var(--ink);
  }

  .math-layer__lead {
    font-weight: 600;
    color: var(--signal);
  }

  summary:hover .math-layer__title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .math-layer__body {
    padding: 0 0 1.2rem 2.15rem;
  }
</style>

<style is:global>
  ::view-transition-group(*) {
    animation-duration: var(--dur);
    animation-timing-function: var(--ease);
  }
</style>
