---
/** Mono small-caps line above a heading, e.g. "Act I · The Lost Planet", with a rule after it. */
interface Props {
  tone?: 'signal' | 'faint';
}

const { tone = 'signal' } = Astro.props;
---

<p class:list={['eyebrow', tone]}>
  <slot />
</p>

<style>
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin: 0 0 1.1rem;
    font-family: var(--f-mono);
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--signal);
  }

  .eyebrow.faint {
    color: var(--ink-faint);
  }

  .eyebrow::after {
    content: '';
    flex: 1;
    max-width: 12rem;
    height: 1px;
    background: var(--rule);
  }
</style>
