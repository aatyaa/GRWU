---
/** A sentence worth stopping on, set large in the display face. <em> marks the turn. */
---

<div class="pull">
  <slot />
</div>

<style>
  .pull {
    margin: var(--space-12) auto;
    max-width: 30ch;
    font-family: var(--f-display);
    font-size: clamp(1.6rem, 3.4vw, 2.3rem);
    line-height: 1.22;
    text-align: center;
    color: var(--ink);
  }

  .pull :global(p) {
    margin: 0;
  }

  .pull :global(em) {
    font-style: italic;
    color: var(--signal);
  }
</style>
