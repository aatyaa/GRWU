---
/**
 * A block of code with a title, and optionally what running it prints. Plain monospace in the
 * site's colours: no syntax colouring, so every line keeps its contrast in both themes. Long
 * lines scroll, so the block can be focused and scrolled from the keyboard.
 */
interface Props {
  title: string;
  code: string;
  output?: string;
}

const { title, code, output } = Astro.props;
---

<figure class="code-block">
  <figcaption>{title}</figcaption>
  <pre tabindex="0" role="region" aria-label={`Code: ${title}`}><code>{code.trim()}</code></pre>
  {output && (
    <div class="code-block__out">
      <p>what you should see</p>
      <pre
        tabindex="0"
        role="region"
        aria-label={`Output: ${title}`}
      ><code>{output.trim()}</code></pre>
    </div>
  )}
</figure>

<style>
  .code-block {
    margin: var(--space-6) 0;
  }

  figcaption,
  .code-block__out p {
    margin: 0 0 var(--space-2);
    font-family: var(--f-mono);
    font-size: var(--text-xs);
    color: var(--ink-soft);
  }

  pre {
    overflow-x: auto;
    margin: 0;
    padding: 0.8rem 1rem;
    border: 1px solid var(--rule-soft);
    border-radius: 8px;
    background: var(--surface);
    color: var(--ink);
    font-size: 0.8rem;
    line-height: 1.55;
  }

  .code-block__out {
    margin-top: var(--space-3);
  }

  .code-block__out pre {
    background: var(--ground);
    color: var(--ink-soft);
  }
</style>
