---
import Mark from '~/components/brand/Mark.astro';
import { withBase } from '~/lib/url';

const current = Astro.url.pathname;
const links = [
  { href: withBase(), label: 'Articles' },
  { href: withBase('about/'), label: 'About' },
];
---

<header class="site-header">
  <a class="brand" href={withBase()}>
    <Mark size={26} />
    <span>GRWU</span>
  </a>
  <nav aria-label="Main">
    <ul>
      {links.map((link) => (
        <li>
          <a href={link.href} aria-current={current === link.href ? 'page' : undefined}>
            {link.label}
          </a>
        </li>
      ))}
      <li>
        <grwu-theme-toggle>
          <button type="button" class="theme">
            Theme: auto
          </button>
        </grwu-theme-toggle>
      </li>
    </ul>
  </nav>
</header>

<script>
  import '~/elements/theme-toggle';
</script>

<style>
  .site-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem var(--gutter);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    border: 0;
    padding: 0;
    color: var(--ink);
    font-family: var(--f-body);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: 0.04em;
  }

  nav {
    margin-inline-start: auto;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a,
  .theme {
    border: 0;
    padding: 0;
    background: none;
    font: inherit;
    font-size: 0.95rem;
    color: var(--ink-soft);
    cursor: pointer;
  }

  nav a:hover,
  .theme:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
  }

  nav a[aria-current='page'] {
    font-weight: 600;
  }
</style>
