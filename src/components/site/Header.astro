---
import Mark from '~/components/brand/Mark.astro';
import { withBase } from '~/lib/url';
import { type Lang, localePath } from '~/lib/i18n';

interface Props {
  running?: string;
  lang?: Lang;
  /** URL of the counterpart page in the other language (ADR 0012). */
  counterpartUrl?: string;
}

const { running, lang = 'en', counterpartUrl } = Astro.props;
const current = Astro.url.pathname;
const isAr = lang === 'ar';

const links = isAr
  ? [
      { href: withBase(localePath('ar', '')), label: 'المقالات' },
      { href: withBase(localePath('ar', 'start/')), label: 'ابدأ هنا' },
      { href: withBase('about/'), label: 'عن الموقع' },
    ]
  : [
      { href: withBase(), label: 'Articles' },
      { href: withBase('start/'), label: 'Start' },
      { href: withBase('ringdown/'), label: 'Ringdown' },
      { href: withBase('about/'), label: 'About' },
    ];

const otherLangLabel = isAr ? 'EN' : 'AR';
const otherLangHref = counterpartUrl ?? (isAr ? withBase('') : withBase(localePath('ar', '')));
---

<header class="site-header">
  <a class="brand" href={isAr ? withBase(localePath('ar', '')) : withBase()}>
    <Mark size={26} />
    <span>GRWU</span>
  </a>
  {running && (
    <p class="running" aria-label="Running title">
      {running}
    </p>
  )}
  <nav aria-label={isAr ? 'الرئيسية' : 'Main'}>
    <ul>
      {links.map((link) => (
        <li>
          <a href={link.href} aria-current={current === link.href ? 'page' : undefined}>
            {link.label}
          </a>
        </li>
      ))}
      <li>
        <a
          href={otherLangHref}
          class="lang-toggle"
          lang={isAr ? 'en' : 'ar'}
          hreflang={isAr ? 'en' : 'ar'}
        >
          {otherLangLabel}
        </a>
      </li>
      <li>
        <grwu-theme-toggle>
          <button type="button" class="theme">
            Theme: auto
          </button>
        </grwu-theme-toggle>
      </li>
    </ul>
  </nav>
</header>

<script>
  import '~/elements/theme-toggle';
</script>

<style>
  .site-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem var(--gutter);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    border: 0;
    padding: 0;
    color: var(--ink);
    font-family: var(--f-body);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: 0.04em;
  }

  nav {
    margin-inline-start: auto;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a,
  .theme {
    border: 0;
    padding: 0;
    background: none;
    font: inherit;
    font-size: 0.95rem;
    color: var(--ink-soft);
    cursor: pointer;
  }

  nav a:hover,
  .theme:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
  }

  nav a[aria-current='page'] {
    font-weight: 600;
  }

  .lang-toggle {
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--rule-soft);
    border-radius: 4px;
    font-size: 0.82rem;
    letter-spacing: 0.03em;
  }

  .lang-toggle:hover {
    border-color: var(--ink-soft);
    color: var(--ink);
  }

  .running {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.88rem;
    color: var(--ink-soft);
  }

  /* On a phone the links get a row of their own, spread across it, instead of wrapping
     wherever they run out of room. */
  @media (max-width: 600px) {
    .site-header {
      flex-wrap: wrap;
      row-gap: 0.6rem;
    }

    nav {
      flex-basis: 100%;
      margin-inline-start: 0;
    }

    ul {
      flex-wrap: nowrap;
      justify-content: space-between;
      gap: 0.5rem;
    }
  }
</style>
