---
import Mark from '~/components/brand/Mark.astro';
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p class="site-footer__by">
      <Mark size={22} />
      <span>GRWU · visual essays by Attia A. Gadallah</span>
    </p>
    <p>
      Strain data from the <a href="https://gwosc.org/">Gravitational Wave Open Science Center</a> ·{' '}
      <a href="https://github.com/aatyaa/GRWU">Source on GitHub</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-24);
    padding-block: var(--space-8);
    border-top: 1px solid var(--rule);
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer__by {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink);
  }
</style>
