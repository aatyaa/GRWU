---
/**
 * A paragraph with a one-line glimpse of its mathematical layer. On wide screens that
 * support CSS anchor positioning the glimpse sits in the margin beside the paragraph;
 * elsewhere it follows the paragraph. It links to the <MathLayer> it previews, which opens
 * when targeted.
 */
interface Props {
  target: string;
  number: string;
  text: string;
}

const { target, number, text } = Astro.props;
const anchor = `--peek-${target}`;
---

<div class="peek-row">
  <div style={`anchor-name: ${anchor}`}>
    <slot />
  </div>
  <a class="peek" href={`#${target}`} style={`position-anchor: ${anchor}`}>
    <span class="peek__index">{number}</span>
    <span class="peek__text">{text}</span>
  </a>
</div>

<style>
  .peek {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    margin: -0.4rem 0 1.2rem;
    padding: 0 0 0 0.8rem;
    border: 0;
    border-left: 1px solid var(--rule);
    color: var(--ink-faint);
    font-family: var(--f-mono);
    font-size: 0.72rem;
    line-height: 1.55;
  }

  .peek__index {
    flex: none;
    color: var(--signal);
    letter-spacing: 0.08em;
  }

  .peek:hover .peek__text {
    color: var(--ink);
  }

  @supports (anchor-name: --a) {
    @media (min-width: 80rem) {
      .peek {
        position: absolute;
        top: anchor(top);
        left: calc(anchor(right) + 3rem);
        width: 14rem;
        margin: 0;
      }
    }
  }
</style>
