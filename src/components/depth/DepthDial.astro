---
/**
 * Opens or closes every mathematical layer on the page at once, and remembers the choice.
 * A radio pair rather than a toggle button, so it works (and reads) as a setting.
 */
const options = [
  { value: 'story', label: 'Story only' },
  { value: 'math', label: 'With the mathematics' },
];
---

<grwu-depth-dial class="depth-dial">
  <fieldset>
    <legend>Read</legend>
    {options.map((option) => (
      <label>
        <input type="radio" name="depth" value={option.value} checked={option.value === 'story'} />
        <span>{option.label}</span>
      </label>
    ))}
  </fieldset>
</grwu-depth-dial>

<script>
  import '~/elements/depth-dial';
</script>

<style>
  .depth-dial {
    display: block;
  }

  fieldset {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    margin: 0;
    padding: 3px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--surface);
  }

  legend {
    float: left;
    padding: 0 0.5rem 0 0.7rem;
    font-family: var(--f-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  label {
    position: relative;
  }

  input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  span {
    display: inline-block;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    font-family: var(--f-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  input:checked + span {
    color: var(--signal);
    background: var(--signal-bg);
  }

  input:focus-visible + span {
    outline: 2px solid var(--signal);
    outline-offset: 2px;
  }
</style>
