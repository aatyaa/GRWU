---
const options = [
  { value: 'intuition', label: 'Intuition' },
  { value: 'math', label: 'Math' },
  { value: 'code', label: 'Code' },
];
---

<grwu-depth-dial class="depth-dial">
  <fieldset>
    <legend>Open every section at</legend>
    {options.map((option) => (
      <label>
        <input
          type="radio"
          name="depth"
          value={option.value}
          checked={option.value === 'intuition'}
        />
        <span>{option.label}</span>
      </label>
    ))}
  </fieldset>
</grwu-depth-dial>

<script>
  import '~/elements/depth-dial';
</script>

<style>
  .depth-dial {
    display: block;
    margin: var(--space-6) 0;
  }

  fieldset {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-2);
    background: var(--surface-1);
  }

  legend {
    float: left;
    margin-inline-end: var(--space-2);
    padding: 0;
    font-size: var(--text-sm);
    color: var(--ink-2);
  }

  label {
    position: relative;
  }

  input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  span {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-1);
    font-size: var(--text-sm);
  }

  input:checked + span {
    background: var(--ink-1);
    color: var(--surface-1);
  }

  input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
