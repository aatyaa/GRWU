---
/**
 * The check you can run against the thing you care about (What the Wrong Model Knows):
 * goodness of fit and distance from the truth for the one-tone template, by start time.
 */
import { scan } from '~/lib/articles/wrong';
import { linePath, linear, log } from '~/lib/figure/svg';

const points = scan();
const W = 560;
const H = 330;
const PAD = { l: 44, r: 16 };
const TOP = { y0: 34, y1: 132 };
const BOT = { y0: 184, y1: 290 };
const ms = points.map((p) => p.start * 1e3);
const x = linear(0, ms[ms.length - 1], PAD.l, W - PAD.r);
const cy = linear(0, 4, TOP.y1, TOP.y0);
const oy = log(0.5, 100, BOT.y1, BOT.y0);
const chi = points.map((p) => Math.min(p.one.chi2dof, 4));
const off = points.map((p) => Math.min(Math.max(Math.abs(p.one.off), 0.5), 100));

// Start times where the fit already looks fine but the answer is still more than 3σ off.
const fooled = points.filter((p) => p.one.chi2dof < 1.3 && Math.abs(p.one.off) > 3);
const from = fooled.length ? fooled[0].start * 1e3 : 0;
const to = fooled.length ? fooled[fooled.length - 1].start * 1e3 : 0;
---

<svg
  class="fig"
  viewBox={`0 0 ${W} ${H}`}
  role="img"
  aria-label={`Two curves against the start of the fit. The goodness of fit falls to about one by ${from.toFixed(2)} milliseconds; the distance from the truth stays above three error bars until ${to.toFixed(2)} milliseconds. In between, the fit looks fine and the answer is not.`}
>
  <rect
    class="fooled"
    x={x(from)}
    y={TOP.y0}
    width={x(to) - x(from)}
    height={BOT.y1 - TOP.y0}
  ></rect>
  <text x={(x(from) + x(to)) / 2} y={cy(2.6)} text-anchor="middle">
    looks fine · is not
  </text>

  <text class="caps" x={PAD.l} y={TOP.y0 - 14}>
    goodness of fit, χ² per degree of freedom
  </text>
  {[1, 2, 3, 4].map((v) => (
    <g>
      <line class="grid" x1={PAD.l} x2={W - PAD.r} y1={cy(v)} y2={cy(v)} />
      <text x={PAD.l - 8} y={cy(v)} dy="4" text-anchor="end">
        {v}
      </text>
    </g>
  ))}
  <path class="check" d={linePath(ms, chi, x, cy)}></path>

  <text class="caps" x={PAD.l} y={BOT.y0 - 14}>
    distance from the truth, in error bars
  </text>
  {[1, 3, 10, 30, 100].map((v) => (
    <g>
      <line class="grid" x1={PAD.l} x2={W - PAD.r} y1={oy(v)} y2={oy(v)} />
      <text x={PAD.l - 8} y={oy(v)} dy="4" text-anchor="end">
        {v}
      </text>
    </g>
  ))}
  <path class="wrong" d={linePath(ms, off, x, oy)}></path>

  <line class="axis" x1={PAD.l} x2={W - PAD.r} y1={BOT.y1} y2={BOT.y1}></line>
  {[0, 1, 2, 3, 4, 5, 6].map((t) => (
    <text x={x(t)} y={BOT.y1 + 18} text-anchor="middle">
      {t}
    </text>
  ))}
  <text x={W - PAD.r} y={H - 4} text-anchor="end">
    start of the fit (ms after the peak)
  </text>
</svg>

<style>
  .fooled {
    fill: var(--bias-bg);
  }

  .check {
    fill: none;
    stroke: var(--ink-soft);
    stroke-width: 2;
  }

  .wrong {
    fill: none;
    stroke: var(--bias);
    stroke-width: 2;
  }
</style>
