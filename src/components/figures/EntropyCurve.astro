---
/**
 * Entropy against mass is a parabola (Only Ever Forwards): S = 4πGM²k_B/ħc for a hole without
 * spin. GW250114's two holes, 33.6 and 32.2 solar masses (LVK 2025), held S₁ + S₂ apart; one
 * hole of their combined mass would hold more, because the curve bends up. The hole they
 * actually made is lighter and spinning, and still holds more than the two did.
 */
import { linear } from '~/lib/figure/svg';
import { entropySun } from '~/lib/physics/horizon';

const M1 = 33.6;
const M2 = 32.2;
const MF = 62.7;
const CHI_F = 0.68;
const UNIT = 1e80;

const s1 = entropySun(M1) / UNIT;
const s2 = entropySun(M2) / UNIT;
const total = M1 + M2;
const apart = s1 + s2;
const together = entropySun(total) / UNIT;
const remnant = entropySun(MF, CHI_F) / UNIT;

const W = 600;
const H = 300;
const PAD = { l: 56, r: 24, t: 30, b: 44 };
const x = linear(0, 70, PAD.l, W - PAD.r);
const y = linear(0, 5, H - PAD.b, PAD.t);
const curve = Array.from({ length: 141 }, (_, i) => {
  const m = i / 2;
  return `${i ? 'L' : 'M'}${x(m).toFixed(1)},${y(entropySun(m) / UNIT).toFixed(1)}`;
}).join('');
const f2 = (v: number) => v.toFixed(2);
---

<svg
  class="fig entropy-curve"
  viewBox={`0 0 ${W} ${H}`}
  role="img"
  aria-label={`Entropy against mass for black holes without spin, a parabola. GW250114's two holes, of ${M1} and ${M2} solar masses, held ${f2(apart)} times ten to the eightieth k_B between them. One hole of the same total mass would hold ${f2(together)}. The hole they actually made, ${MF} solar masses spinning at ${CHI_F}, holds ${f2(remnant)}: more than the two did.`}
>
  <text class="caps" x={PAD.l} y="16">
    entropy, 10⁸⁰ k_B
  </text>
  {[1, 2, 3, 4, 5].map((v) => (
    <>
      <line class="grid" x1={PAD.l} x2={W - PAD.r} y1={y(v)} y2={y(v)} />
      <text x={PAD.l - 8} y={y(v) + 4} text-anchor="end">
        {v}
      </text>
    </>
  ))}
  <path class="model" d={curve} />
  <text class="halo" x={x(24) - 6} y={y(entropySun(24) / UNIT) - 12} text-anchor="end">
    S ∝ M², no spin
  </text>
  <line class="gain" x1={x(total)} x2={x(total)} y1={y(apart)} y2={y(together)} />
  <circle class="dot" cx={x(M1)} cy={y(s1)} r="4" />
  <circle class="dot" cx={x(M2)} cy={y(s2)} r="4" />
  <text class="halo" x={x(M2) + 8} y={y(s2) + 16}>
    the two holes, each on the curve
  </text>
  <circle class="dot" cx={x(total)} cy={y(apart)} r="5" />
  <text class="ink halo" x={x(total) - 10} y={y(apart) + 4} text-anchor="end">
    the two together, apart: {f2(apart)}
  </text>
  <circle class="hypothetical" cx={x(total)} cy={y(together)} r="4.5" />
  <text class="halo" x={x(total) - 10} y={y(together) + 4} text-anchor="end">
    one hole of the same mass: {f2(together)}
  </text>
  <circle class="dot" cx={x(MF)} cy={y(remnant)} r="6" />
  <text class="signal halo" x={x(MF) - 10} y={y(remnant) + 4} text-anchor="end">
    the hole GW250114 made, lighter and spinning: {f2(remnant)}
  </text>
  <line class="axis" x1={PAD.l} x2={W - PAD.r} y1={H - PAD.b} y2={H - PAD.b} />
  {[0, 10, 20, 30, 40, 50, 60, 70].map((m) => (
    <text x={x(m)} y={H - PAD.b + 16} text-anchor="middle">
      {m}
    </text>
  ))}
  <text x={W - PAD.r} y={H - 6} text-anchor="end">
    mass, solar masses
  </text>
</svg>

<style>
  .entropy-curve text.halo {
    paint-order: stroke;
    stroke: var(--ground);
    stroke-width: 4px;
    stroke-linejoin: round;
  }

  .entropy-curve .hypothetical {
    fill: var(--surface);
    stroke: var(--model);
    stroke-width: 1.6;
  }

  .entropy-curve .gain {
    stroke: var(--ink-soft);
    stroke-width: 1.4;
    stroke-dasharray: 2 3;
  }
</style>
