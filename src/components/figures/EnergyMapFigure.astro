---
/**
 * A time–frequency energy map drawn at build time (A Peak Is Only a Candidate). The map is a
 * greyscale PNG used as an SVG luminance mask over the signal colour, so it follows the theme.
 */
import type { EnergyMap } from '~/lib/articles/candidate';
import { linear, log } from '~/lib/figure/svg';

interface Props {
  map: EnergyMap;
  /** Unique within the page: the SVG mask id. */
  id: string;
  title: string;
  label: string;
  width?: number;
  timeTicks?: number[];
}

const { map, id, title, label, width = 600, timeTicks } = Astro.props;
const H = 250;
const PAD = { l: 44, r: 10, t: 26, b: 40 };
const x = linear(map.t0, map.t1, PAD.l, width - PAD.r);
const y = log(map.fLo, map.fHi, H - PAD.b, PAD.t);
const fTicks = [30, 50, 100, 200, 500].filter((f) => f >= map.fLo && f <= map.fHi);
const span = map.t1 - map.t0;
const tTicks =
  timeTicks ??
  Array.from({ length: 5 }, (_, i) => Number((map.t0 + (span * (i + 0.5)) / 5).toFixed(2)));
const box = { x: PAD.l, y: PAD.t, w: width - PAD.l - PAD.r, h: H - PAD.t - PAD.b };
---

<svg class="fig energy-map" viewBox={`0 0 ${width} ${H}`} role="img" aria-label={label}>
  <defs>
    <mask id={id} maskUnits="userSpaceOnUse" x={box.x} y={box.y} width={box.w} height={box.h}>
      <image
        href={map.uri}
        x={box.x}
        y={box.y}
        width={box.w}
        height={box.h}
        preserveAspectRatio="none"
        style="image-rendering: pixelated"
      />
    </mask>
  </defs>
  <text class="caps" x={PAD.l} y="14">
    {title}
  </text>
  <rect class="plot" x={box.x} y={box.y} width={box.w} height={box.h}></rect>
  <rect class="energy" x={box.x} y={box.y} width={box.w} height={box.h} mask={`url(#${id})`}></rect>
  {fTicks.map((f) => (
    <text x={PAD.l - 6} y={y(f)} dy="4" text-anchor="end">
      {f}
    </text>
  ))}
  <text x="6" y={PAD.t - 8}>
    Hz
  </text>
  {tTicks.map((t) => (
    <text x={x(t)} y={H - PAD.b + 16} text-anchor="middle">
      {t === 0 ? '0' : t.toFixed(2).replace('-', '−')}
    </text>
  ))}
  <text x={width - PAD.r} y={H - 6} text-anchor="end">
    seconds from the event
  </text>
</svg>

<style>
  .energy-map {
    display: block;
    width: 100%;
    height: auto;
  }

  .energy-map .plot {
    fill: var(--surface);
    stroke: var(--rule);
  }

  .energy-map .energy {
    fill: var(--signal);
  }
</style>
