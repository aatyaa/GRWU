---
/**
 * The 3+1 split, schematically (Only Ever Forwards): spacetime cut into a stack of spatial
 * slices Σ_t. Between two neighbouring slices the lapse α says how much proper time passes
 * along the normal, and the shift β says how far the spatial coordinates slide sideways. Each
 * slice carries its own geometry γᵢⱼ and its bending in spacetime Kᵢⱼ.
 */
const W = 600;
const H = 290;
const L = 70;
const R = W - 150;
const slices = [0, 1, 2, 3].map((k) => H - 46 - k * 58);
const wave = (base: number, k: number) =>
  Array.from({ length: 61 }, (_, i) => {
    const s = i / 60;
    const xx = L + s * (R - L);
    const yy = base - 10 * Math.sin(2 * Math.PI * (s * 1.3 + k * 0.17)) - 6 * s;
    return `${i ? 'L' : 'M'}${xx.toFixed(1)},${yy.toFixed(1)}`;
  }).join('');
const at = (base: number, k: number, s: number) =>
  base - 10 * Math.sin(2 * Math.PI * (s * 1.3 + k * 0.17)) - 6 * s;
// The point with the same spatial coordinates on slices 1 and 2.
const s0 = 0.38;
const shiftS = 0.17;
const x1 = L + s0 * (R - L);
const y1 = at(slices[1], 1, s0);
const y2normal = at(slices[2], 2, s0);
const x2 = L + (s0 + shiftS) * (R - L);
const y2 = at(slices[2], 2, s0 + shiftS);
---

<svg
  class="fig slice-stack"
  viewBox={`0 0 ${W} ${H}`}
  role="img"
  aria-label="A schematic of spacetime cut into four stacked spatial slices. Between two of them, an arrow along the normal is labelled the lapse, the proper time between the slices, and an arrow along the upper slice is labelled the shift, how far the spatial coordinates slide between them."
>
  <text class="caps" x="12" y="16">
    spacetime, cut into slices of space
  </text>
  {slices.map((base, k) => (
    <>
      <path class="slice" d={wave(base, k)} />
      <text class="ink" x={R + 10} y={at(base, k, 1) + 4}>
        Σ at t{k === 0 ? '' : ` + ${k}`}
      </text>
    </>
  ))}
  <line class="lapse" x1={x1} y1={y1} x2={x1} y2={y2normal + 3} marker-end="url(#slice-arrow)" />
  <text class="ink halo" x={x1 - 8} y={(y1 + y2normal) / 2 + 4} text-anchor="end">
    lapse α
  </text>
  <line
    class="shift"
    x1={x1}
    y1={y2normal}
    x2={x2 - 4}
    y2={y2 + 1}
    marker-end="url(#slice-arrow)"
  />
  <text class="ink halo" x={(x1 + x2) / 2} y={y2 - 14} text-anchor="middle">
    shift β
  </text>
  <line class="same" x1={x1} y1={y1} x2={x2} y2={y2} />
  <circle class="dot ink" cx={x1} cy={y1} r="4" />
  <circle class="dot ink" cx={x2} cy={y2} r="4" />
  <text x={x1 + 10} y={y1 + 22}>
    dashed: the same spatial coordinates, one slice later
  </text>
  <text x={12} y={H - 8}>
    each slice carries γᵢⱼ, its geometry, and Kᵢⱼ, how it bends in spacetime
  </text>
  <defs>
    <marker
      id="slice-arrow"
      viewBox="0 0 10 10"
      refX="9"
      refY="5"
      markerWidth="7"
      markerHeight="7"
      orient="auto"
    >
      <path d="M0,0L10,5L0,10Z" class="arrowhead" />
    </marker>
  </defs>
</svg>

<style>
  .slice-stack text.halo {
    paint-order: stroke;
    stroke: var(--ground);
    stroke-width: 4px;
    stroke-linejoin: round;
  }

  .slice-stack .slice {
    fill: none;
    stroke: var(--model);
    stroke-width: 1.5;
  }

  .slice-stack .lapse,
  .slice-stack .shift {
    stroke: var(--ink);
    stroke-width: 1.6;
  }

  .slice-stack .same {
    stroke: var(--ink-soft);
    stroke-width: 1;
    stroke-dasharray: 3 3;
  }

  .slice-stack .arrowhead {
    fill: var(--ink);
  }
</style>
