{
  "name": "grwu",
  "version": "0.0.0",
  "private": true,
  "description": "GRWU: visual, interactive explanations of gravitational-wave data analysis.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "node scripts/pyodide-assets.mjs && astro dev",
    "build": "node scripts/pyodide-assets.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "astro check && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "node scripts/pyodide-assets.mjs && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "budgets": "node scripts/check-budgets.mjs",
    "seal:ringdown": "pnpm build && node scripts/seal-ringdown.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm budgets",
    "pyodide": "node scripts/pyodide-assets.mjs",
    "links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.2",
    "@astrojs/svelte": "9.1.2",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource/archivo": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@nanostores/persistent": "1.3.5",
    "@raspberrypifoundation/python-friendly-error-messages": "0.8.0",
    "@threlte/core": "8.7.0",
    "astro": "7.4.5",
    "codemirror": "6.0.2",
    "comlink": "4.4.2",
    "d3-array": "3.2.5",
    "d3-format": "3.1.3",
    "d3-scale": "4.0.3",
    "d3-shape": "3.2.1",
    "fft.js": "4.0.4",
    "idb-keyval": "6.3.0",
    "katex": "0.19.1",
    "nanostores": "1.5.5",
    "pyodide": "314.0.7",
    "svelte": "5.57.3",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@types/d3-array": "^3.2.2",
    "@types/d3-format": "^3.0.4",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.20.5",
    "@types/three": "0.187.0",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-svelte": "3.24.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "license": "MIT"
}
