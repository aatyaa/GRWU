{
  "name": "grwu",
  "version": "0.0.0",
  "private": true,
  "description": "GRWU: visual, interactive explanations of gravitational-wave data analysis.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "astro check && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "budgets": "node scripts/check-budgets.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm budgets"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.2",
    "@astrojs/svelte": "9.0.1",
    "@nanostores/persistent": "1.3.5",
    "astro": "7.3.5",
    "comlink": "4.4.2",
    "fft.js": "4.0.4",
    "nanostores": "1.5.4",
    "pyodide": "314.0.7",
    "svelte": "5.57.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.4",
    "eslint": "10.11.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
